{
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#000",
    "activityBar.background": "#000",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#6e123f",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#000",
    "statusBar.background": "#000",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#000",
    "statusBarItem.remoteBackground": "#000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#000",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#000",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#185592",
  "cSpell.words": ["informations"],
  "eslint.useFlatConfig": true,
  "eslint.debug": true,
  "eslint.options": {
    "overrideConfigFile": "eslint.config.mjs"
  },
  "[typescript][json][jsonc][yaml][dockercompose][handlebars][javascript][dotenv][shellscript][dockerfile]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  }
}
